# Generated by pozor config template. Runtime settings: pozor config set / admin.
# Configuration directory: POZOR_HOME, otherwise the project root.
# POZOR_HOME=/path/to/pozor
# Каталог SQLite, секретов и сессий; на Windows ограничьте ACL; owner=bootstrap; restart required.
POZOR_DATA_DIR=data
# Пароль входа в админку, минимум 16 символов; значение не показывается; owner=secret; restart required.
ADMIN_PASSWORD=
# admin host; owner=bootstrap; restart required.
ADMIN_HOST=127.0.0.1
# admin port; owner=bootstrap; restart required.
ADMIN_PORT=8090
# admin secure cookie; owner=bootstrap; restart required.
ADMIN_SECURE_COOKIE=false
# Токен Telegram-бота от BotFather; обязателен для serve; owner=secret; restart required.
BOT_TOKEN=
# owner ids; owner=bootstrap; restart required.
OWNER_IDS=[]
# database path; owner=bootstrap; restart required.
DATABASE_PATH=data/pozor.sqlite3
# llm base url; owner=bootstrap; restart required.
LLM_BASE_URL=http://127.0.0.1:8080
# llm model; owner=bootstrap; restart required.
LLM_MODEL=pozor-local
# llm api key; owner=secret; restart required.
LLM_API_KEY=
# telegram api id; owner=credentials; restart required.
TELEGRAM_API_ID=
# telegram api hash; owner=credentials; restart required.
TELEGRAM_API_HASH=
# log level; owner=bootstrap; restart required.
LOG_LEVEL=INFO
