BOT_TOKEN=replace_me
OWNER_IDS=[123456789]
# Add and enable chats through the admin UI; permissions are stored in SQLite.
DATABASE_PATH=./data/pozor.sqlite3
# Set a unique password of at least 16 characters before starting the admin UI.
ADMIN_PASSWORD=
# Local LLM endpoint. For the admin UI using the Compose LLM, use port 18080.
# The bot inside Compose uses http://llm:8080 (set by compose.yaml).
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=pozor-local
LLM_API_KEY=
CONTEXT_SIZE=8192
MAX_OUTPUT_TOKENS=180
GENERATION_DEADLINE_SECONDS=8
HISTORICAL_TOKEN_BUDGET=1200
PER_TOPIC_LIMIT=2
RETRIEVAL_WEIGHTS=[1.0,0.8,0.5,0.6]
LIVE_RETENTION_DAYS=30
IMPORT_RETENTION_DAYS=90
PROFILE_CARDS_ENABLED=false
SEMANTIC_PROFILES_ENABLED=true
# Developer credentials for the optional admin Telegram connection (my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOG_LEVEL=INFO
